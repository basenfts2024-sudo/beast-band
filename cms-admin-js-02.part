iv class="block-head"><strong>Past member</strong></div><div class="block-body"><div class="fields">${input('band.pastMember.name','Name')}${input('band.pastMember.role','Role')}${input('band.pastMember.bio','Biography','textarea',true)}${input('band.instrumentation','Instrumentation copy','textarea',true)}</div></div></div>`}
function renderAlbums(){return head('Albums','Artwork, release information, streaming links and tracklists can all be edited here.')+content.albums.map((a,i)=>`<article class="block"><div class="block-head"><strong>${esc(a.title)}</strong></div><div class="block-body"><div class="fields">${[['title','Title'],['year','Year'],['type','Type'],['image','Artwork URL'],['recorded','Recorded'],['release','Release'],['spotify','Spotify URL'],['apple','Apple Music URL'],['youtube','YouTube URL'],['total','Total length']].map(([k,l])=>`<div class="field"><label>${l}</label><input data-album="${i}" data-k="${k}" value="${esc(a[k]||'')}"></div>`).join('')}<div class="field full"><label>Description</label><textarea data-album="${i}" data-k="description">${esc(a.description||'')}</textarea></div></div><div class="eyebrow" style="margin:24px 0 10px">Tracklist</div>${(a.tracks||[]).map((t,ti)=>`<div class="fields" style="margin-bottom:8px"><div class="field"><label>Track ${ti+1}</label><input data-track="${i}" data-ti="${ti}" data-k="title" value="${esc(t.title)}"></div><div class="field"><label>Time</label><input data-track="${i}" data-ti="${ti}" data-k="time" value="${esc(t.time)}"></div></div>`).join('')}<button class="repeater-add" data-add-track="${i}">+ Add track</button></div></article>`).join('')}
function renderLyrics(){return head('Lyrics','Each song has its own collapsible editor for the full lyrics. Open only the song you are working on.')+content.albums.map((a,i)=>`<article class="block"><div class="block-head"><strong>${esc(a.title)} · ${esc(a.year||'')}</strong></div><div class="block-body"><div class="eyebrow" style="margin:0 0 14px">Songs</div>${(a.tracks||[]).map((t,ti)=>`<details class="block" style="margin-bottom:10px"><summary style="cursor:pointer;display:flex;justify-content:space-between;gap:18px;align-items:center;padding:16px 18px;font-weight:700"><span>${String(ti+1).padStart(2,'0')} — ${esc(t.title||'Untitled song')}</span><span style="font-size:11px;font-weight:400;opacity:.6">${esc(t.time||'')} · Edit lyrics</span></summary><div class="block-body" style="border-top:1px solid rgba(0,0,0,.12)"><div class="fields"><div class="field"><label>Song title</label><input data-track="${i}" data-ti="${ti}" data-k="title" value="${esc(t.title||'')}"></div><div class="field"><label>Time</label><input data-track="${i}" data-ti="${ti}" data-k="time" value="${esc(t.time||'')}"></div><div class="field full"><label>Full lyrics</label><textarea data-track="${i}" data-ti="${ti}" data-k="lyrics" style="min-height:320px;white-space:pre-wrap" placeholder="Paste the full lyrics here…">${esc(t.lyrics||'')}</textarea></div></div></div></details>`).join('')}<button class="repeater-add" data-add-track="${i}">+ Add song</button><p class="help">Song titles and times remain synced with Albums. Lyrics are stored separately on each track.</p></div></article>`).join('')}
function renderShows(){return head('Shows','Add new gigs, correct dates, or reorder the live archive.')+listEditor('shows',content.shows,[['year','Year'],['date','Date'],['venue','Venue / city'],['title','Show title'],['copy','Description','textarea',true],['source','Source URL','text',true]],newMap.shows,x=>x.title)}
function renderNews(){return head('News','The Latest Update tab is controlled separately from the historical Press archive.')+`<div class="fields" style="margin-bottom:24px">${input('news.intro','News section introduction','textarea',true)}</div><div class="eyebrow" style="margin:25px 0 10px">Latest updates</div>${listEditor('latest',content.news.latestUpdates,[['date','Date'],['category','Category'],['title','Title'],['summary','Summary','textarea',true],['body','Body / link','textarea',true]],newMap.latest,x=>x.title)}<div class="eyebrow" style="margin:35px 0 10px">Press archive</div>${listEditor('articles',content.news.articles,[['date','Date'],['category','Category'],['title','Title'],['summary','Summary','textarea',true],['body','Body / source','textarea',true]],newMap.articles,x=>x.title)}`}
function renderInterviews(){return head('Band Interviews','Each member has their own editable question set. Add or remove questions freely.')+Object.entries(content.interviews||{}).map(([name,qs])=>`<article class="block"><div class="block-head"><strong>${esc(name)}</strong></div><div class="block-body">${qs.map((q,i)=>`<div class="field" style="margin-bottom:10px"><label>Question ${String(i+1).padStart(2,'0')}</label><textarea data-question="${esc(name)}" data-qi="${i}">${esc(q)}</textarea></div>`).join('')}<button class="repeater-add" data-add-question="${esc(name)}">+ Add question</button></div></article>`).join('')}
function renderGallery(){return head('Gallery','Paste a new IPFS/Filebase image URL, drag it through the order with the arrows, or remove it.')+`<div class="gallery-grid-admin">${content.gallery.map((url,i)=>`<div class="gallery-card"><img src="${esc(url)}" alt="Gallery ${i+1}"><input data-gallery="${i}" value="${esc(url)}"><div class="row-actions"><button class="mini" data-gmove="up" data-i="${i}">↑</button><button class="mini" data-gmove="down" data-i="${i}">↓</button><button class="mini" data-gremove="${i}">Remove</button></div></div>`).join('')}</div><button class="repeater-add" id="gallery-add" style="margin-top:14px">+ Add image</button>`}
function renderVideo(){return head('Videography','Edit the title, service/year label and link displayed beside each video.')+listEditor('video',content.videography,[['number','Number'],['title','Title'],['meta','Platform / year'],['url','Link URL']],newMap.video,x=>x.title)}
function renderTimeline(){return head('Timeline','Every historical step is editable and reorderable.')+listEditor('timeline',content.timeline,[['year','Year'],['title','Title'],['copy','Description','textarea',true],['source','Source URL','text',true]],newMap.timeline,x=>x.title)}
function renderSubmit(){return head('Submit','Change the archive invitation and the three explanatory steps while keeping the form design intact.')+`<div class="fields">${input('submit.pageEyebrow','Page eyebrow')}${input('submit.pageTitle','Page title')}${input('submit.kicker','Kicker')}${input('submit.headline','Headline','textarea')}${input('submit.intro1','Intro paragraph 1','textarea',true)}${input('submit.intro2','Intro paragraph 2','textarea',true)}${input('submit.archiveNote','Archive note','textarea',true)}</div><div class="eyebrow" style="margin:30px 0 10px">Steps</div>${listEditor('steps',content.submit.steps,[['title','Title'],['copy','Copy','textarea',true]],newMap.steps,x=>x.title)}`}
function renderContact(){return head('Contact','Update the addresses and location used throughout the site.')+`<div class="fields">${input('contact.pageEyebrow','Page eyebrow')}${input('contact.pageTitle','Page title')}${input('contact.bookingsEmail','Bookings email')}${input('contact.pressEmail','Press email')}${input('contact.location','Location')}${input('contact.facebook','Facebook URL','url')}</div>`}
function renderSocials(){return head('Social Links','These appear on the home page, news page and footer.')+listEditor('socials',content.socials,[['name','Platform'],['handle','Handle / label'],['url','URL']],newMap.socials,x=>x.name)}
const renderers={general:renderGenera