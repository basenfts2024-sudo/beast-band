pointer}.gallery img{width:100%;height:auto;display:block;filter:none;transition:transform .25s}.gallery figure:hover img{transform:scale(1.025)}.form-layout{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid;gap:40px;padding-top:20px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.field{display:flex;flex-direction:column;gap:7px}.field.full{grid-column:1/-1}.field label{font-size:10px;text-transform:uppercase;letter-spacing:.13em}.field input,.field textarea{border:1px solid;background:transparent;padding:13px}.field textarea{min-height:135px;resize:vertical}.submit-btn{background:#111;color:#fff;border:1px solid;padding:13px 16px;text-transform:uppercase;letter-spacing:.13em;font-size:10px;cursor:pointer}.submit-btn:hover{background:transparent;color:#111}.contact-grid{display:grid;grid-template-columns:repeat(3,1fr);border-left:1px solid;border-top:1px solid}.contact-item{min-height:185px;border-right:1px solid;border-bottom:1px solid;padding:22px}.contact-item strong{font-size:26px;display:block;margin-top:45px}.footer{border-top:1px solid;padding:28px 0 48px}.footer-in{display:grid;grid-template-columns:1fr auto;gap:30px;align-items:start}.foot-brand{display:flex;gap:22px;flex-wrap:wrap;font-size:11px;text-transform:uppercase;letter-spacing:.11em}.foot-links{display:flex;gap:15px;flex-wrap:wrap;font-size:10px;text-transform:uppercase;letter-spacing:.12em}.lightbox{position:fixed;inset:0;background:rgba(0,0,0,.93);z-index:100;display:none;align-items:center;justify-content:center;padding:30px}.lightbox.open{display:flex}.lightbox img{max-width:94vw;max-height:88vh}.close{position:absolute;right:25px;top:20px;color:#fff;background:none;border:0;font-size:36px;cursor:pointer}.notice{margin-top:15px;font-size:12px;color:var(--muted)}
@media(max-width:950px){.nav{display:none;position:absolute;top:74px;left:0;right:0;background:var(--bg);border-bottom:1px solid;padding:18px 28px;flex-direction:column;align-items:flex-start}.nav.open{display:flex}.menu{display:block;margin-left:auto}.hero{grid-template-columns:1fr}.hero-photo{min-height:430px}.tiles{grid-template-columns:1fr 1fr}.news-home,.follow,.form-layout{grid-template-columns:1fr}.section-grid,.twocol,.news-grid,.contact-grid{grid-template-columns:1fr}.album{grid-template-columns:1fr}.timeline-row{grid-template-columns:95px 1fr}.timeline-row .meta:last-child{display:none}.gallery{grid-template-columns:1fr 1fr}.footer-in{grid-template-columns:1fr}}
@media(max-width:620px){.wrap{padding:0 17px}.page{padding-top:36px}.header-in{height:64px}.nav{top:64px;padding-left:17px;padding-right:17px}.title{font-size:18vw}.home-title{font-size:25vw}.hero-bottom{grid-template-columns:1fr}.tiles,.gallery,.form-grid{grid-template-columns:1fr}.lineup-row{grid-template-columns:38px 1fr}.lineup-row .meta{display:none}.timeline-row,.show,.track{grid-template-columns:1fr}.timeline-row .year{font-size:16px}.show>div:last-child{display:none}.album h2{font-size:48px}.video-row{grid-template-columns:45px 1fr}.video-row .meta{display:none}.foot-links{gap:10px}}
.tracklist{margin:26px 0 20px;border-top:1px solid #bdbdbd}.trackline{display:grid;grid-template-columns:42px 1fr auto;gap:14px;align-items:center;padding:10px 0;border-bottom:1px solid #d2d2d2}.trackline strong{font-size:15px}.trackline span:first-child{font-size:11px;letter-spacing:.08em}.tracklist .meta{font-size:11px}

/* Dynamic image sizing + full-width landing hero */
img{height:auto;max-width:100%}
.home-page{overflow:hidden}
.home-copy{display:block;padding-top:16px;border-top:1px solid;margin-bottom:42px}
.home-copy .hero-bottom{margin-top:42px}
.hero-fullbleed{width:100vw;margin-left:calc(50% - 50vw);min-height:0;height:auto;overflow:visible;background:transparent}
.hero-fullbleed img{display:block;width:100vw;max-width:none;height:auto;object-fit:contain}
.album img{width:auto;max-width:100%;height:auto;aspect-ratio:auto;object-fit:contain;display:block}
.show-hero{height:auto;overflow:visible}
.show-hero img{width:auto;max-width:100%;height:auto;object-fit:contain;display:block}
.gallery{display:block;column-count:3;column-gap:10px}
.gallery figure{display:inline-block;width:100%;margin:0 0 10px;break-inside:avoid;overflow:visible;background:transparent}
.gallery img{width:100%;height:auto;max-width:100%;object-fit:contain;display:block}
@media(max-width:950px){.gallery{column-count:2}.hero-fullbleed{min-height:0}}
@media(max-width:620px){.gallery{column-count:1}.home-copy .hero-bottom{margin-top:28px}}

