/* Landing page v2 — photo-first, full-bleed hero */
.home-main{overflow:hidden}
.home-hero{position:relative;width:100vw;height:min(82vw,860px);min-height:560px;background:#0b0b0b;overflow:hidden}
.home-hero>img{position:absolute;inset:0;width:100%;height:100%;max-width:none;object-fit:cover;object-position:center;display:block}
