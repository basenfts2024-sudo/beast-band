l,home:renderHome,band:renderBand,albums:renderAlbums,lyrics:renderLyrics,shows:renderShows,news:renderNews,interviews:renderInterviews,gallery:renderGallery,video:renderVideo,timeline:renderTimeline,submit:renderSubmit,contact:renderContact,socials:renderSocials};
const GOOGLE_CLIENT_ID='795220644196-3nmjjdevr2dc2qjfb0dd8dmb4engckn7.apps.googleusercontent.com';
const ALLOWED_GOOGLE_EMAILS=['houjoubeckmann@gmail.com','futurenowza@gmail.com','basenfts2024@gmail.com'];
let googleCredential=sessionStorage.getItem('beast_google_credential')||'';
function renderShell(){app.innerHTML=`<div class="cms"><aside class="sidebar"><div class="brand"><strong>BEAST</strong><span>Content editor</span></div><div class="sections">${sections.map(([k,l],i)=>`<button class="section-btn ${k===current?'active':''}" data-section="${k}"><span>${String(i+1).padStart(2,'0')}</span>${l}</button>`).join('')}</div><div class="side-bottom"><a href="/" target="_blank">Open live site ↗</a><button class="ghost" id="logout">Log out</button></div></aside><main class="main"><div class="topbar"><div><div class="eyebrow">Editing</div><h1>${sections.find(x=>x[0]===current)?.[1]}</h1></div><div class="actions"><span class="status" id="save-status">Saved</span><button class="ghost" id="draft">Save draft</button><button class="primary" id="publish">Publish changes</button></div></div><div class="editor" id="editor"></div></main></div>`;
 document.querySelectorAll('[data-section]').forEach(b=>b.onclick=()=>{current=b.dataset.section;renderShell();renderSection()});
 document.querySelector('#logout').onclick=()=>{sessionStorage.removeItem('beast_google_credential');sessionStorage.removeItem('beast_admin_key');googleCredential='';key='';login()};
 document.querySelector('#draft').onclick=()=>{localStorage.setItem('beast_cms_draft',JSON.stringify(content));document.querySelector('#save-status').textContent='Draft saved locally'};
 document.querySelector('#publish').onclick=publish;
 renderSection();
}
function renderSection(){const e=document.querySelector('#editor');if(!e)return;e.innerHTML=renderers[current]();bindFields(e);bindLists();bindSpecial()}
function bindSpecial(){
 document.querySelectorAll('[data-album]').forEach(el=>el.oninput=()=>{content.albums[+el.dataset.album][el.dataset.k]=el.value;markDirty()});
 document.querySelectorAll('[data-track]').forEach(el=>el.oninput=()=>{content.albums[+el.dataset.track].tracks[+el.dataset.ti][el.dataset.k]=el.value;markDirty()});
 document.querySelectorAll('[data-add-track]').forEach(b=>b.onclick=()=>{content.albums[+b.dataset.addTrack].tracks.push({title:'New track',time:''});markDirty();renderSection()});
 document.querySelectorAll('[data-question]').forEach(el=>el.oninput=()=>{content.interviews[el.dataset.question][+el.dataset.qi]=el.value;markDirty()});
 document.querySelectorAll('[data-add-question]').forEach(b=>b.onclick=()=>{content.interviews[b.dataset.addQuestion].push('New question');markDirty();renderSection()});
 document.querySelectorAll('[data-gallery]').forEach(el=>el.oninput=()=>{content.gallery[+el.dataset.gallery]=el.value;markDirty()});
 document.querySelectorAll('[data-gremove]').forEach(b=>b.onclick=()=>{content.gallery.splice(+b.dataset.gremove,1);markDirty();renderSection()});
 document.querySelectorAll('[data-gmove]').forEach(b=>b.onclick=()=>{const i=+b.dataset.i,j=b.dataset.gmove==='up'?i-1:i+1;if(j<0||j>=content.gallery.length)return;[content.gallery[i],content.gallery[j]]=[content.gallery[j],content.gallery[i]];markDirty();renderSection()});
 const ga=document.querySelector('#gallery-add');if(ga)ga.onclick=()=>{content.gallery.push('https://');markDirty();renderSection()};
}
async function publish(){const btn=document.querySelector('#publish');btn.disabled=true;document.querySelector('#save-status').textContent='Publishing…';try{const r=await fetch('/api/content',{method:'PUT',headers:{'Content-Type':'application/json',...(googleCredential?{'Authorization':'Bearer '+googleCredential}:{'x-admin-key':key})},body:JSON.stringify(content)});const j=await r.json();if(!r.ok)throw new Error(j.error||'Publish failed');original=clone(content);dirty=false;localStorage.removeItem('beast_cms_draft');document.querySelector('#save-status').textContent='Published';setTimeout(()=>document.querySelector('#save-status')&&(document.querySelector('#save-status').textContent='Saved'),2500)}catch(e){document.querySelector('#save-status').textContent=e.message;if(e.message.toLowerCase().includes('auth')){sessionStorage.removeItem('beast_google_credential')}}finally{btn.disabled=false}}
function decodeGoogleCredential(token){try{return JSON.parse(decodeURIComponent(escape(atob(token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/')))))}catch{return null}}
function googleCallback(response){const p=decodeGoogleCredential(response.credential);const email=String(p?.email||'').toLowerCase();if(!p?.email_verified||!ALLOWED_GOOGLE_EMAILS.includes(email)){login('This Google account is not approved for BEAST CMS.');return}googleCredential=response.credential;sessionStorage.setItem('beast_google_credential',googleCredential);load()}
function loadGoogle(){if(window.google?.accounts?.id){google.accounts.id.initialize({client_id:GOOGLE_CLIENT_ID,callback:googleCallback});google.accounts.id.renderButton(document.querySelector('#google-signin'),{theme:'outline',size:'large',width:320,text:'signin_with'});return}const s=document.createElement('script');s.src='https://accounts.google.com/gsi/client';s.async=true;s.onload=loadGoogle;document.head.appendChild(s)}
function login(message=''){app.innerHTML=`<div class="login"><section class="login-art"><div class="eyebrow">BEAST / ADMIN</div><h1>Content<br>editor.</h1><p>Edit the live website section by section. Access is restricted to approved BEAST Google accounts.</p></section><section class="login-box"><div class="login-card"><div class="eyebrow">Band access</div><h2>Sign in with Google</h2>${message?`<div class="notice bad">${esc(message)}</div>`:''}<div id="google-signin" style="margin-top:22px"></div><p class="help">Only approved BEAST accounts can access and publish.</p></div></section></div>`;loadGoogle()}
async function load(){app.innerHTML='<div class="admin-loading">Loading BEAST content…</div>';try{const r=await fetch('/api/content?ts='+Date.now(),{cache:'no-store'});if(!r.ok)throw new Error('Could not load content');content=await r.json();const draft=localStorage.getItem('beast_cms_draft');if(draft){try{content=JSON.parse(draft);dirty=true}catch{}}original=clone(content);renderShell()}catch(e){login(e.message)}}
if(googleCredential)load();else login();
