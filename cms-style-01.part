:root{--bg:#f5f4ef;--ink:#0b0b0b;--muted:#6c6a65;--hair:#1a1a1a;--max:1510px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:Arial,Helvetica,sans-serif;font-size:14px}a{color:inherit;text-decoration:none}button,input,textarea{font:inherit;color:inherit}.wrap{max-width:var(--max);margin:auto;padding:0 28px}.header{position:sticky;top:0;z-index:50;background:rgba(245,244,239,.96);backdrop-filter:blur(10px);border-bottom:1px solid var(--hair)}.header-in{height:74px;display:flex;align-items:center}.logo{font-size:31px;font-weight:900;letter-spacing:-.075em;text-transform:uppercase}.nav{margin-left:auto;display:flex;gap:27px;align-items:center}.nav a,.menu{font-size:11px;text-transform:uppercase;letter-spacing:.16em}.nav a:hover,.nav a.active{text-decoration:underline;text-underline-offset:6px}.menu{display:none;border:1px solid;padding:8px 10px;background:transparent}.main{min-height:70vh}.page{padding:58px 0 110px}.eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:.19em;color:var(--muted);margin-bottom:17px}.title{font-size:clamp(74px,10.2vw,170px);font-weight:900;line-height:.77;letter-spacing:-.08em;text-transform:uppercase;margin:0 0 48px}.home-title{font-size:clamp(92px,15vw,240px);font-weight:900;letter-spacing:-.09em;line-height:.72;text-transform:uppercase;margin:0}.rule{border-top:1px solid}.hero{display:grid;grid-template-columns:minmax(0,1.42fr) minmax(300px,.58fr);gap:18px;min-height:calc(100vh - 120px)}.hero-copy{display:flex;flex-direction:column;justify-content:space-between;padding-top:16px;border-top:1px solid}.hero-photo{overflow:hidden;min-height:620px;background:#111}.hero-photo img{width:100%;height:100%;object-fit:cover;display:block;filter:none}.hero-bottom{display:grid;grid-template-columns:1fr 1fr;gap:25px;align-items:end}.hero-bottom p{font-size:clamp(17px,1.65vw,27px);line-height:1.22;margin:0}.lineup{border-top:1px solid}.lineup-row{display:grid;grid-template-columns:55px 1fr 1fr;padding:11px 0;border-bottom:1px solid;gap:16px}.lineup-row strong{font-size:17px}.meta{font-size:11px;text-transform:uppercase;letter-spacing:.12em;color:var(--muted)}.text-link{text-transform:uppercase;letter-spacing:.13em;font-size:11px;border-bottom:1px solid;display:inline-block;padding-bottom:3px}.tiles{display:grid;grid-template-columns:repeat(5,1fr);border-left:1px solid;border-top:1px solid;margin-top:78px}.tile{min-height:245px;border-right:1px solid;border-bottom:1px solid;padding:18px;display:flex;flex-direction:column;justify-content:space-between}.tile:hover{background:#0b0b0b;color:#f5f4ef}.tile .n{font-size:11px}.tile h3{font-size:26px;line-height:.95;letter-spacing:-.05em;margin:0}.news-home{margin-top:95px;display:grid;grid-template-columns:1fr 2fr;gap:30px;border-top:1px solid;padding-top:20px}.news-list{border-top:1px solid}.news-list article{border-bottom:1px solid;padding:17px 0}.news-list h3{font-size:25px;letter-spacing:-.04em;margin:7px 0}.follow{margin-top:85px;display:grid;grid-template-columns:1fr 2fr;gap:30px}.socials{border-top:1px solid}.socials a{display:flex;justify-content:space-between;border-bottom:1px solid;padding:13px 0}.section-grid{display:grid;grid-template-columns:repeat(2,1fr);border-left:1px solid;border-top:1px solid}.member{min-height:420px;border-right:1px solid;border-bottom:1px solid;padding:22px;display:flex;flex-direction:column;justify-content:space-between}.member h2{font-size:55px;line-height:.88;letter-spacing:-.06em;margin:0 0 12px}.member p,.bodycopy{line-height:1.62;max-width:700px}.band-image{margin-bottom:1px;aspect-ratio:2.1/1;overflow:hidden}.band-image img{width:100%;height:100%;object-fit:cover;filter:none}.twocol{display:grid;grid-template-columns:1fr 1fr;border-left:1px solid;border-top:1px solid;margin-top:45px}.box{border-right:1px solid;border-bottom:1px solid;padding:25px;min-height:230px}.box h2{font-size:40px;letter-spacing:-.05em;margin:5px 0 15px}.timeline{border-top:1px solid}.timeline-row{display:grid;grid-template-columns:150px 1fr 120px;gap:24px;padding:24px 0;border-bottom:1px solid}.year{font-size:46px;font-weight:900;letter-spacing:-.05em}.timeline-row h2{font-size:37px;letter-spacing:-.05em;margin:0 0 8px}.album{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid;padding:25px 0 60px;gap:40px}.album img{width:100%;aspect-ratio:1;object-fit:cover;filter:none}.album h2{font-size:64px;line-height:.9;letter-spacing:-.06em;margin:12px 0 24px}.detail{display:grid;grid-template-columns:110px 1fr;gap:18px;padding:12px 0;border-top:1px solid}.video-list{border-top:1px solid}.video-row{display:grid;grid-template-columns:80px 1fr 170px;padding:15px 0;border-bottom:1px solid;align-items:center}.video-row:hover{background:#111;color:#fff}.tabs,.filters,.types{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 32px}.pill{border:1px solid;background:transparent;padding:8px 11px;font-size:10px;text-transform:uppercase;letter-spacing:.12em;cursor:pointer}.pill.active,.pill:hover{background:#111;color:#fff}.track{display:grid;grid-template-columns:80px 1fr;border-top:1px solid;padding:22px 0}.track h2{font-size:33px;letter-spacing:-.04em;margin:0 0 12px}.lyrics{font-size:17px;line-height:1.55;white-space:pre-line}.show-hero{height:460px;overflow:hidden;margin-bottom:40px}.show-hero img{width:100%;height:100%;object-fit:cover;filter:none}.show{display:grid;grid-template-columns:100px 1fr 130px;gap:20px;padding:23px 0;border-top:1px solid}.show h2{font-size:31px;letter-spacing:-.04em;margin:5px 0}.news-grid{display:grid;grid-template-columns:1fr 1fr;border-left:1px solid;border-top:1px solid}.news-card{border-right:1px solid;border-bottom:1px solid;padding:23px;min-height:310px}.news-card h2{font-size:36px;line-height:1;letter-spacing:-.05em;margin:14px 0}.news-card p{line-height:1.6}.gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.gallery figure{margin:0;position:relative;overflow:hidden;background:#111;cursor: