:root{--paper:#f5f4ef;--ink:#0b0b0b;--muted:#77746e;--line:#bdb9b0;--panel:#ebe9e3;--white:#fff;--ok:#126b31;--danger:#b10f16}*{box-sizing:border-box}html,body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif}button,input,textarea{font:inherit;color:inherit}.admin-loading{min-height:100vh;display:grid;place-items:center;text-transform:uppercase;letter-spacing:.12em;font-size:12px}.login{min-height:100vh;display:grid;grid-template-columns:1fr 1fr}.login-art{padding:36px;border-right:1px solid var(--ink);display:flex;flex-direction:column;justify-content:space-between}.login-art h1{font-size:clamp(76px,13vw,190px);line-height:.78;letter-spacing:-.075em;text-transform:uppercase;margin:0}.login-art p{max-width:520px;font-size:18px;line-height:1.45}.login-box{display:flex;align-items:center;padding:8vw}.login-card{width:min(520px,100%)}.eyebrow,.label{font-size:11px;letter-spacing:.13em;text-transform:uppercase}.login-card h2{font-size:44px;letter-spacing:-.05em;margin:12px 0 32px}.login-card input{width:100%;background:transparent;border:0;border-bottom:1px solid var(--ink);padding:14px 0;font-size:20px}.primary,.ghost,.danger{border:1px solid var(--ink);background:var(--ink);color:var(--paper);padding:13px 17px;cursor:pointer}.ghost{background:transparent;color:var(--ink)}.danger{background:transparent;color:var(--danger);border-color:var(--danger)}.login-card button{margin-top:24px;width:100%}.cms{min-height:100vh;display:grid;grid-template-columns:270px minmax(0,1fr)}.sidebar{position:sticky;top:0;height:100vh;border-right:1px solid var(--ink);display:flex;flex-direction:column}.brand{padding:24px;border-bottom:1px solid var(--ink)}.brand strong{font-size:30px;letter-spacing:-.05em}.brand span{display:block;margin-top:4px;font-size:10px;text-transform:uppercase;letter-spacing:.14em}.sections{padding:12px;overflow:auto}.section-btn{width:100%;display:grid;grid-template-columns:28px 1fr;text-align:left;border:0;background:transparent;padding:11px 8px;cursor:pointer;border-bottom:1px solid transparent}.section-btn span{font-size:10px;opacity:.45;padding-top:3px}.section-btn.active{border-color:var(--ink);font-weight:700}.side-bottom{margin-top:auto;padding:16px;border-top:1px solid var(--ink);display:grid;gap:8px}.side-bottom a{text-decoration:none;color:inherit;font-size:12px}.main{min-width:0}.topbar{position:sticky;top:0;z-index:5;background:rgba(245,244,239,.96);backdrop-filter:blur(8px);border-bottom:1px solid var(--ink);min-height:74px;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;gap:18px}.topbar h1{margin:0;font-size:25px;letter-spacing:-.04em}.actions{display:flex;align-items:center;gap:8px}.status{font-size:11px;text-transform:uppercase;letter-spacing:.08em;margin-right:8px}.editor{padding:34px 24px 100px;max-width:1200px}.section-head{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:end;padding-bottom:26px;border-bottom:1px solid var(--ink);margin-bottom:28px}.section-head h2{font-size:clamp(46px,7vw,94px);line-height:.82;letter-spacing:-.065em;text-transform:uppercase;margin:10px 0 0}.section-head p{margin:0;font-size:16px;line-height:1.5;max-width:500px}.fields{display:grid;grid-template-columns:1fr 1fr;gap:18px}.field{display:grid;gap:7px}.field.full{grid-column:1/-1}.field label{font-size:10px;letter-spacing:.12em;text-transform:uppercase;opacity:.65}.field input,.field textarea{width:100%;border:1px solid var(--line);background:rgba(255,255,255,.25);padding:12px;border-radius:0}.field textarea{min-height:115px;resize:vertical}.block{border:1px solid var(--ink);margin:0 0 16px}.block-head{display:flex;justify-content:space-between;align-items:center;padding:13px 14px;border-bottom:1px solid var(--ink);background:var(--panel)}.block-head strong{font-size:16px}.block-body{padding:16px}.row-actions{display:flex;gap:6px}.mini{padding:6px 9px;border:1px solid var(--ink);background:transparent;cursor:pointer;font-size:11px}.repeater-add{width:100%;border:1px dashed var(--ink);background:transparent;padding:14px;cursor:pointer;text-transform:uppercase;letter-spacing:.09em;font-size:11px}.image-preview{width:100%;max-height:250px;object-fit:contain;object-position:left;background:#ddd;margin-top:8px}.gallery-grid-admin{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.gallery-card{border:1px solid var(--line);padding:9px}.gallery-card img{width:100%;height:150px;object-fit:cover;display:block;background:#ddd}.gallery-card input{width:100%;margin-top:8px;border:0;border-bottom:1px solid var(--line);background:transparent;padding:8px 0;font-size:11px}.gallery-card .row-actions{margin-top:8px}.notice{padding:12px;border:1px solid var(--line);font-size:12px;margin-bottom:18px}.notice.ok{border-color:var(--ok);color:var(--ok)}.notice.bad{border-color:var(--danger);color:var(--danger)}.password-row{display:flex;gap:8px;margin-top:18px}.password-row input{flex:1}.dirty-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--danger);margin-right:7px}.help{font-size:12px;line-height:1.5;color:var(--muted);margin-top:9px}@media(max-width:900px){.cms{grid-template-columns:1fr}.sidebar{position:relative;height:auto;border-right:0;border-bottom:1px solid var(--ink)}.sections{display:flex;overflow:auto}.section-btn{min-width:150px}.side-bottom{display:none}.topbar{top:0}.section-head{grid-template-columns:1fr;gap:18px}.fields{grid-template-columns:1fr}.field.full{grid-column:auto}.gallery-grid-admin{grid-template-columns:1fr 1fr}.login{grid-template-columns:1fr}.login-art{min-height:45vh;border-right:0;border-bottom:1px solid var(--ink)}}@media(max-width:560px){.gallery-grid-admin{grid-template-columns:1fr}.actions .ghost{display:none}.editor{padding-left:14px;padding-right:14px}.topbar{padding-left:14px;padding-right:14px}}
