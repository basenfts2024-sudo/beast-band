Smoke Swig Swear · 2013</button><button class="pill" data-album="bardo">Bardo · 2015</button></div><div id="lyrics-list"></div>`)}
function renderLyrics(k='smoke'){const e=document.querySelector('#lyrics-list');if(!e)return;const a=albumsData[k];e.innerHTML=`<div class="lyrics-simple">${a.tracks.map((t,i)=>`<div class="lyric-name"><span>${String(i+1).padStart(2,'0')}</span><strong>${t[0]}</strong></div>`).join('')}</div>`}
function showsPage(){const ce=CMS.contact||{};return `<main class="main"><section class="page"><div class="wrap"><div class="eyebrow">Live & festival history</div><div class="show-hero"><img src="${ASSETS.shows}" alt="BEAST performing live under stage lights"></div>${shows.map((s,i)=>`<article class="show"><div><div class="meta">${s[0]}</div><div style="margin-top:8px">${s[1]}</div></div><div><strong>${s[2]}</strong><h2>${s[3]}</h2><p class="bodycopy">${s[4]}</p>${s[5]?`<a class="text-link archive-source" target="_blank" rel="noreferrer" href="${s[5]}">Source ↗</a>`:''}</div><div class="meta">Show ${String(i+1).padStart(2,'0')} / ${String(shows.length).padStart(2,'0')}</div></article>`).join('')}<div class="twocol"><div class="box"><div class="eyebrow">Booking</div><h2>Future dates</h2></div><div class="box"><p class="bodycopy">For future bookings, festival slots and press enquiries, head to the <a class="text-link" href="#/contact">contact page</a> or email ${ce.bookingsEmail||'bookings@beastband.co.za'}.</p></div></div></div></section></main>`};
function interviewSection(){return `<div class="band-interviews"><div class="interview-intro"><div class="eyebrow">Band interviews</div><h2>Four members.<br>Forty questions.</h2><p>Individual question sets for each member of BEAST — covering the band's origins, writing, recording, live shows and the two-bass setup.</p></div><div class="interview-card-grid">${Object.entries(interviewQuestions).map(([name,qs],mi)=>`<section class="interview-card"><div class="interview-card-head"><span class="interview-number">${String(mi+1).padStart(2,'0')}</span><div><div class="meta">10 questions</div><h3>${name}</h3></div></div><div class="question-list">${qs.map((q,qi)=>`<div class="question-row"><span>${String(qi+1).padStart(2,'0')}</span><p>${q}</p></div>`).join('')}</div></section>`).join('')}</div></div>`}
function newsPage(){const n=CMS.news||{};return shell(n.intro||'Read the latest news directly from the band.','News',`<div class="filters">${['All','Latest Update','Band Interviews','Press'].map((f,i)=>`<button class="pill ${i===0?'active':''}" data-filter="${f}">${f}</button>`).join('')}</div><div id="news-grid" class="news-grid"></div><div class="twocol"><div class="box"><div class="eyebrow">Got something?</div><p class="bodycopy">Press enquiries and interview requests go through the <a class="text-link" href="#/contact">contact page</a>. Fans with photos, flyers or bootlegs can <a class="text-link" href="#/submit">submit content</a> to the archive.</p></div><div class="box"><div class="eyebrow">Follow</div>${socials.map(s=>`<div style="padding:8px 0"><a class="text-link" href="${s[2]}" target="_blank">${s[0]}</a></div>`).join('')}</div></div>`)}
function renderNews(f='All'){const e=document.querySelector('#news-grid');if(!e)return;if(f==='Band Interviews'){e.innerHTML=interviewSection();return;}const latest=(CMS.news&&Array.isArray(CMS.news.latestUpdates))?CMS.news.latestUpdates.map(x=>[x.date||'',x.category||'Update',x.title||'',x.summary||'',x.body||'']):[];const items=f==='Latest Update'?latest:news;e.innerHTML=items.map((n,i)=>`<article class="news-card"><div class="meta">${n[0]}</div><div class="meta" style="margin-top:7px">${f==='Latest Update'?'Update':'Press'} · ${String(i+1).padStart(2,'0')} / ${String(items.length).padStart(2,'0')}</div><h2>${n[2]}</h2><p>${n[3]}</p><p>${String(n[4]||'').replace(/(https?:\/\/[^\s]+)/g,'<a class="source-link" target="_blank" rel="noreferrer" href="$1">Read original article →</a>')}</p></article>`).join('')||`<div class="box"><div class="eyebrow">Latest update</div><p class="bodycopy">${CMS.news?.intro||'Read the latest news directly from the band.'}</p></div>`}
function gallery(){return shell('Live & portraits','Gallery',`<div class="gallery">${ASSETS.gallery.map((g,i)=>`<figure data-img="${g}"><img src="${g}" alt="BEAST gallery image ${i+1}" loading="lazy"></figure>`).join('')}</div>`)}
function submitPage(){const x=CMS.submit||{},steps=x.steps||[];return shell(x.pageEyebrow||'Fan archive',x.pageTitle||'Submit',`<section class="submit-v2-hero"><div class="submit-v2-kicker">${x.kicker||'BEAST ARCHIVE / CAPE TOWN'}</div><div class="submit-v2-grid"><div><h2>${htmlLines(x.headline||'Keep the\nnoise alive.')}</h2></div><div class="submit-v2-copy"><p>${x.intro1||''}</p><p>${x.intro2||''}</p></div></div></section><section class="submit-v2-body"><div class="submit-v2-left">${steps.map((st,i)=>`<div class="submit-step"><span>${String(i+1).padStart(2,'0')}</span><div><strong>${st.title||''}</strong><p>${st.copy||''}</p></div></div>`).join('')}<div class="submit-credit"><div class="eyebrow">Archive note</div><p>${x.archiveNote||''}</p></div></div><form id="submit-form" class="submit-v2-form"><div class="submit-v2-formtop"><div><div class="eyebrow">Submission type</div><div class="types submit-v2-types">${['Photos','Video','Audio / bootleg','Flyer / poster','Story'].map((z,i)=>`<button type="button" class="pill ${i===0?'active':''}" data-type="${z}">${z}</button>`).join('')}</div><input type="hidden" name="type" value="Photos"></div><div class="submit-v2-mark">01—05</div></div><div class="submit-v2-fields"><div class="field"><label>Your name / credit</label><input name="name" required></div><div class="field"><label>Email</label><input name="email" type="email" required></div><div class="field"><label>Show / venue</label><input name="show"></div><div class="field"><label>Link</label><input name="link"></div><div class="field full"><label>Tell us about it</label><textarea name="notes"></textarea></div>