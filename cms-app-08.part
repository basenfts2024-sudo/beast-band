><div class="field full submit-v2-upload"><label>Attach a file</label><input name="file" type="file"><span>JPEG · RAW · VIDEO · AUDIO · PDF</span></div><div class="field full"><button class="submit-btn submit-v2-button"><span>Send to archive</span><span>↗</span></button></div></div><div id="submit-msg" class="notice"></div></form></section>`)}
function contact(){const c=CMS.contact||{};return shell(c.pageEyebrow||'Bookings · Press · Noise',c.pageTitle||'Contact',`<div class="contact-grid"><div class="contact-item"><div class="meta">Bookings</div><strong>${c.bookingsEmail||'bookings@beastband.co.za'}</strong></div><div class="contact-item"><div class="meta">Press</div><strong>${c.pressEmail||'press@beastband.co.za'}</strong></div><div class="contact-item"><div class="meta">Based in</div><strong>${c.location||'Cape Town, South Africa'}</strong></div></div><div class="form-layout" style="margin-top:50px"><div><div class="eyebrow">Elsewhere</div><a class="text-link" target="_blank" href="${c.facebook||'https://www.facebook.com/BEASTBAND'}">Facebook</a></div><form id="contact-form"><div class="eyebrow">Send a message</div><div class="form-grid"><div class="field"><label>Name</label><input name="name" required></div><div class="field"><label>Email</label><input name="email" type="email" required></div><div class="field full"><label>Subject</label><div class="types">${['Booking','Press','Licensing','Something else'].map((x,i)=>`<button type="button" class="pill ${i===0?'active':''}" data-subject="${x}">${x}</button>`).join('')}</div><input type="hidden" name="subject" value="Booking"></div><div class="field full"><label>Message</label><textarea name="message" required></textarea></div><div class="field full"><button class="submit-btn">Send it</button></div></div></form></div>`)}
function admin(){location.href='/admin.html';return ''}
const routes={'/':home,'/band':band,'/timeline':timelinePage,'/albums':albums,'/lyrics':lyricsPage,'/shows':showsPage,'/news':newsPage,'/gallery':gallery,'/submit':submitPage,'/contact':contact,'/admin':admin};
function path(){return (location.hash.slice(1)||'/').replace(/\/$/,'')||'/'}
function bind(){document.querySelector('.menu')?.addEventListener('click',()=>document.querySelector('.nav').classList.toggle('open'));document.querySelectorAll('.nav a').forEach(a=>a.classList.toggle('active',a.getAttribute('href')===`#${path()}`));document.querySelectorAll('[data-album]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-album]').forEach(x=>x.classList.remove('active'));b.classList.add('active');renderLyrics(b.dataset.album)});if(path()==='/lyrics')renderLyrics();document.querySelectorAll('[data-filter]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-filter]').forEach(x=>x.classList.remove('active'));b.classList.add('active');renderNews(b.dataset.filter)});if(path()==='/news')renderNews();document.querySelectorAll('.gallery figure').forEach(f=>f.onclick=()=>{document.querySelector('.lightbox img').src=f.dataset.img;document.querySelector('.lightbox').classList.add('open')});document.querySelector('.close')?.addEventListener('click',()=>document.querySelector('.lightbox').classList.remove('open'));document.querySelector('.lightbox')?.addEventListener('click',e=>{if(e.target.classList.contains('lightbox'))e.currentTarget.classList.remove('open')});document.querySelectorAll('[data-type]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-type]').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.querySelector('[name=type]').value=b.dataset.type});document.querySelectorAll('[data-subject]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-subject]').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.querySelector('[name=subject]').value=b.dataset.subject});document.querySelector('#submit-form')?.addEventListener('submit',e=>{e.preventDefault();const f=new FormData(e.target);const a=JSON.parse(localStorage.getItem('beast_submissions')||'[]');a.unshift({type:f.get('type'),name:f.get('name'),email:f.get('email'),show:f.get('show'),link:f.get('link'),notes:f.get('notes'),file:f.get('file')?.name||'',created:new Date().toISOString()});localStorage.setItem('beast_submissions',JSON.stringify(a));document.querySelector('#submit-msg').textContent='Saved locally in this independent build.';e.target.reset()});document.querySelector('#contact-form')?.addEventListener('submit',e=>{e.preventDefault();const f=new FormData(e.target);const cc=CMS.contact||{};const to=f.get('subject')==='Press'?(cc.pressEmail||'press@beastband.co.za'):(cc.bookingsEmail||'bookings@beastband.co.za');location.href=`mailto:${to}?subject=${encodeURIComponent('BEAST — '+f.get('subject'))}&body=${encodeURIComponent('Name: '+f.get('name')+'\nEmail: '+f.get('email')+'\n\n'+f.get('message'))}`})}
function render(){const p=path();document.getElementById('root').innerHTML=header()+(routes[p]||home)()+footer()+`<div class="lightbox"><button class="close">×</button><img alt="Gallery image"></div>`;bind();window.scrollTo(0,0)}
addEventListener('hashchange',render);loadCMS().finally(render);
